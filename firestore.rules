rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Allow test connection
    match /test/connection {
      allow read: if true;
    }

    // Custom Elements
    match /user_elements/{elementId} {
      function isValidElement(data) {
        return data.keys().hasAll(['name', 'id', 'color', 'userId']) &&
               data.name is string && data.name.size() <= 64 &&
               data.id is string && data.id.size() <= 64 &&
               data.color is string && data.color.matches('^#[0-9a-fA-F]{6}$') &&
               data.userId == request.auth.uid;
      }

      allow get: if true;
      allow list: if true; // Public list allowed, or restrict if desired
      allow create: if isSignedIn() && isValidElement(request.resource.data) && isValidId(elementId);
      allow update: if isOwner(resource.data.userId) && isValidElement(request.resource.data);
      allow delete: if isOwner(resource.data.userId);
    }
    
    // Maps
    match /user_maps/{mapId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }
  }
}
